    { "source": "/tools/rent-calculator.html", "destination": "/money-tax/rent-calculator", "permanent": true },
    { "source": "/tools/rent-calculator", "destination": "/money-tax/rent-calculator", "permanent": true },
    { "source": "/tools/payment-calendar.html", "destination": "/money-tax/payment-calendar", "permanent": true },
    { "source": "/tools/payment-calendar", "destination": "/money-tax/payment-calendar", "permanent": true },
    { "source": "/tools/visa-pathway.html", "destination": "/visas/visa-pathway", "permanent": true },
